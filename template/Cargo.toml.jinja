{% if workspace_mode == 'real' -%}
[workspace]
members = ["."]
resolver = "2"

[workspace.package]
version = "0.1.0"
description = "{{ description }}"
authors = [{% if authors %}{% for author in authors.split(',') %}"{{ author.strip() }}"{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}]
license = "{{ license }}"
edition = "2024"
rust-version = "{{ rust_version }}"

[package]
name = "{{ crate_name }}"
version.workspace = true
description.workspace = true
authors.workspace = true
license.workspace = true
edition.workspace = true
rust-version.workspace = true
{% else -%}
[package]
name = "{{ crate_name }}"
version = "0.1.0"
description = "{{ description }}"
authors = [{% if authors %}{% for author in authors.split(',') %}"{{ author.strip() }}"{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}]
license = "{{ license }}"
edition = "2024"
rust-version = "{{ rust_version }}"
{% if workspace_mode == 'isolated' %}
[workspace]
{% endif -%}
{% endif -%}
{% if 'library' in crate_shape %}
[lib]
name = "{{ crate_name | replace('-', '_') }}"
path = "src/lib.rs"
{% endif -%}
{% if 'executable' in crate_shape %}
[[bin]]
name = "{{ crate_name }}"
path = "src/main.rs"
{% endif -%}
{% if enable_property_tests or enable_benchmarking %}
[dev-dependencies]
{% if enable_property_tests -%}
proptest = "1"
{% endif -%}
{% if enable_benchmarking -%}
criterion = "0.5"
{% endif -%}
{% endif -%}
{% if enable_benchmarking %}
[[bench]]
name = "benchmark"
harness = false
{% endif %}
