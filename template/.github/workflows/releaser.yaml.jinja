name: release

on:
  push:
    tags: [ 'v[0-9]+.*' ]
  workflow_dispatch:
    inputs:
      dry-run:
        description: 'Skip actual publishing (test build only)'
        required: false
        type: boolean
        default: true

env:
  CARGO_TERM_COLOR: always

jobs:

  initialize:
    uses: ./.github/workflows/core--initializer.yaml

  release-gates:
    needs: [initialize]
    strategy:
      fail-fast: true
      matrix:
        cell: {% raw %}${{ fromJSON(needs.initialize.outputs.cells) }}{% endraw %}
    runs-on: {% raw %}${{ matrix.cell.runner }}{% endraw %}
    steps:

      - name: Check Out
        uses: actions/checkout@v7

      - name: Set Up Toolchain
        uses: dtolnay/rust-toolchain@stable

      - name: Add Target
        run: rustup target add {% raw %}${{ matrix.cell.target }}{% endraw %}

      - name: Install nextest
        run: cargo install cargo-nextest --version 0.9.146 --locked

      - name: Generate Lockfile If Missing
        run: test -f Cargo.lock || cargo generate-lockfile
        shell: bash

      - name: Build Release
        run: cargo build --release --locked --all-targets

      - name: Test Release
        env:
          RUST_BACKTRACE: '1'
        run: cargo nextest run --release --locked --no-tests=warn

      - name: Package
        run: cargo package --locked --no-verify
{%- if enable_publication %}
  # Operator prerequisites, both one-time per crate:
  # - Register a crates.io trusted publisher before the first release. The
  #   template promises no tokenless first publication and stores no
  #   long-lived token.
  # - Binary GitHub releases require repository attestation support: a public
  #   repository, or GitHub Enterprise Cloud for a private one. On plans
  #   without it the publish-github job fails visibly at the attest step;
  #   attestation is never silently skipped.
  publish-crates-io:
    if: {% raw %}${{ !inputs.dry-run && startsWith(github.ref, 'refs/tags/') }}{% endraw %}
    needs: [initialize, release-gates]
    runs-on: ubuntu-latest
    environment: crates-io
    permissions:
      contents: read
      id-token: write
    steps:

      - name: Check Out
        uses: actions/checkout@v7

      - name: Set Up Toolchain
        uses: dtolnay/rust-toolchain@stable

      - name: Generate Lockfile If Missing
        run: test -f Cargo.lock || cargo generate-lockfile
        shell: bash

      - name: Authenticate to crates.io
        id: auth
        uses: rust-lang/crates-io-auth-action@v1.0.6

      - name: Publish to crates.io
        run: cargo publish --locked
        env:
          CARGO_REGISTRY_TOKEN: {% raw %}${{ steps.auth.outputs.token }}{% endraw %}
{%- if 'executable' in crate_shape %}

  build-binaries:
    needs: [initialize, release-gates]
    strategy:
      fail-fast: true
      matrix:
        cell: {% raw %}${{ fromJSON(needs.initialize.outputs.cells) }}{% endraw %}
    runs-on: {% raw %}${{ matrix.cell.runner }}{% endraw %}
    steps:

      - name: Check Out
        uses: actions/checkout@v7

      - name: Set Up Toolchain
        uses: dtolnay/rust-toolchain@stable

      - name: Add Target
        run: rustup target add {% raw %}${{ matrix.cell.target }}{% endraw %}

      - name: Generate Lockfile If Missing
        run: test -f Cargo.lock || cargo generate-lockfile
        shell: bash

      - name: Build Release Binary
        run: cargo build --release --locked

      - name: Determine Binary Name
        id: binary
        shell: bash
        # Matrix values arrive via env, never interpolated into the script:
        # they are template-generated constants, but the habit must be uniform.
        env:
          BINARY_TARGET: {% raw %}${{ matrix.cell.target }}{% endraw %}
          BINARY_OS: {% raw %}${{ matrix.cell.os }}{% endraw %}
        run: |
          set -eu
          target="${BINARY_TARGET}"
          if [[ "${BINARY_OS}" == "windows" ]]; then
            binary_name="{{ crate_name }}-${target}.exe"
            cp "target/release/{{ crate_name }}.exe" "${binary_name}"
          else
            binary_name="{{ crate_name }}-${target}"
            cp "target/release/{{ crate_name }}" "${binary_name}"
          fi
          echo "name=${binary_name}" >>${GITHUB_OUTPUT}

      - name: Upload Binary Artifact
        uses: actions/upload-artifact@v7
        with:
          name: binary-{% raw %}${{ matrix.cell.os }}-${{ matrix.cell.cpu }}{% endraw %}
          path: {% raw %}${{ steps.binary.outputs.name }}{% endraw %}

  publish-github:
    if: {% raw %}${{ !inputs.dry-run && startsWith(github.ref, 'refs/tags/') }}{% endraw %}
    needs: [initialize, build-binaries]
    runs-on: ubuntu-latest
    permissions:
      artifact-metadata: write
      attestations: write
      contents: write
      id-token: write
    steps:

      - name: Check Out
        uses: actions/checkout@v7

      - name: Download All Binaries
        uses: actions/download-artifact@v8
        with:
          path: artifacts
          pattern: binary-*
          merge-multiple: true

      - name: Generate Checksums
        working-directory: artifacts
        run: |
          shopt -s nullglob
          sha256sum {{ crate_name }}-* >SHA256SUMS.txt

      - name: Attest Build Provenance
        id: attest
        uses: actions/attest@v4
        with:
          subject-path: |
            artifacts/SHA256SUMS.txt
            artifacts/{{ crate_name }}-*

      - name: Stage Attestation Bundle
        # actions/attest records provenance in the repository API and emits a
        # local bundle at an action-chosen path. Copy it under a deterministic
        # name into artifacts/ so the release upload below attaches it. The
        # output reference arrives via env so no expression text is
        # interpolated into the script.
        env:
          BUNDLE_PATH: {% raw %}${{ steps.attest.outputs.bundle-path }}{% endraw %}
        run: |
          set -eu
          cp "${BUNDLE_PATH}" "artifacts/{{ crate_name }}-provenance.sigstore.json"

      - name: Create Release
        # Tag and repository metadata arrive via env, never interpolated into
        # the script: a tag name is attacker-reachable ref metadata and must
        # be treated as data, so gh receives it literally. Options precede a
        # `--` delimiter with the tag after it, so a leading-dash tag on a
        # manual dispatch cannot parse as a gh option.
        env:
          GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          RELEASE_TAG: {% raw %}${{ github.ref_name }}{% endraw %}
        run: |
          gh release create \
            --repo "${GITHUB_REPOSITORY}" \
            --generate-notes \
            -- "${RELEASE_TAG}"

      - name: Upload Release Artifacts
        env:
          GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          RELEASE_TAG: {% raw %}${{ github.ref_name }}{% endraw %}
        run: |
          gh release upload \
            --repo "${GITHUB_REPOSITORY}" \
            -- "${RELEASE_TAG}" \
            artifacts/*
{%- endif %}
{%- endif %}
