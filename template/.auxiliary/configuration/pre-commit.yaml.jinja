# See https://pre-commit.com for more information
# See https://pre-commit.com/hooks.html for more hooks

default_install_hook_types: [ 'pre-commit', 'pre-push' ]

repos:

- repo: https://github.com/pre-commit/pre-commit-hooks
  rev: v6.0.0
  hooks:
  - id: check-added-large-files
    name: 'Check: Large Files'
  - id: check-case-conflict
    name: 'Check: Filename Case Conflict'
  - id: check-merge-conflict
    name: 'Check: Merge Conflict Markers'
  - id: check-symlinks
    name: 'Check: Dangling Symlinks'
  - id: check-vcs-permalinks
    name: 'Check: VCS Permalinks'
  - id: destroyed-symlinks
    name: 'Check: Destroyed Symlinks'
  - id: detect-private-key
    name: 'Check: Detect Private Keys'
  - id: mixed-line-ending
    name: 'Check: Detect Mixed Line Endings'
    args: [ '--fix', 'no' ]
  - id: check-json
    name: 'Validate: JSON Files'
  - id: check-toml
    name: 'Validate: TOML Files'
  - id: check-yaml
    name: 'Validate: YAML Files'
  - id: end-of-file-fixer
    name: 'Fix: End of Files'
  - id: trailing-whitespace
    name: 'Fix: Trailing Whitespace'

- repo: local
  hooks:

  - id: cargo-clippy
    name: 'Lint (Rust: Clippy)'
    language: system
    entry: 'cargo clippy --all-targets -- -D warnings'
    pass_filenames: false
    require_serial: true
    stages: [ 'pre-commit' ]
    fail_fast: true

  - id: cargo-fmt
    name: 'Check Style (Rust)'
    language: system
    entry: 'cargo fmt --all -- --check'
    pass_filenames: false
    require_serial: true
    stages: [ 'pre-commit' ]
    fail_fast: true

  - id: linecheck
    name: 'Check: Line Counts'
    language: system
    entry: 'linecheck --config .auxiliary/configuration/linecheck.yaml src tests'
    pass_filenames: false
    always_run: true
    require_serial: true
    stages: [ 'pre-commit' ]
    fail_fast: true

  - id: cargo-nextest
    name: 'Test (Rust: cargo-nextest)'
    language: system
    entry: "bash -c 'test -f Cargo.lock || cargo generate-lockfile; exec cargo nextest run --locked'"
    pass_filenames: false
    require_serial: true
    stages: [ 'pre-commit' ]
    fail_fast: true
{% if enable_fuzzing %}
  - id: cargo-fuzz
    name: 'Fuzz (cargo-fuzz, bounded)'
    # Requires a nightly toolchain (`rustup toolchain install nightly`):
    # cargo-fuzz needs nightly sanitizer support the pinned stable does not
    # provide. The run bound keeps pushes interactive; raise it for
    # dedicated fuzzing sessions.
    language: system
    entry: 'cargo +nightly fuzz run fuzz_target_1 -- -runs=1000'
    pass_filenames: false
    require_serial: true
    stages: [ 'pre-push' ]
    fail_fast: true
{% endif %}
{% if enable_benchmarking %}
  - id: cargo-bench
    name: 'Benchmark (Criterion)'
    language: system
    entry: 'cargo bench --locked'
    pass_filenames: false
    require_serial: true
    stages: [ 'pre-push' ]
    fail_fast: true
{% endif %}
